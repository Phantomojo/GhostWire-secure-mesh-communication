graph TB
    subgraph "Scenario 1: NOT DECENTRALIZED (Client-Server)"
        YP1[Your Phone<br/>CLIENT]
        YPC1[Your PC<br/>SERVER]
        FPC1[Friend's PC<br/>SERVER]
        FP1[Friend's Phone<br/>CLIENT]
        
        YP1 -->|only connects to| YPC1
        YPC1 <-->|Internet| FPC1
        FP1 -->|only connects to| FPC1
        
        style YP1 fill:#ff6b6b
        style FP1 fill:#ff6b6b
        style YPC1 fill:#4ecdc4
        style FPC1 fill:#4ecdc4
    end
    
    subgraph "Scenario 2: TRULY DECENTRALIZED (Mesh)"
        YP2[Your Phone<br/>PEER]
        YPC2[Your PC<br/>PEER]
        FPC2[Friend's PC<br/>PEER]
        FP2[Friend's Phone<br/>PEER]
        RN[Random Node<br/>PEER]
        
        YP2 <-->|local WiFi| YPC2
        YPC2 <-->|Internet| FPC2
        FPC2 <-->|local WiFi| FP2
        YP2 <-.->|can also connect| FP2
        YP2 <-.->|can discover| FPC2
        YPC2 <-.->|mesh| RN
        RN <-.->|mesh| FP2
        
        style YP2 fill:#95e1d3
        style YPC2 fill:#95e1d3
        style FPC2 fill:#95e1d3
        style FP2 fill:#95e1d3
        style RN fill:#95e1d3
    end
    
    subgraph "Scenario 3: HYBRID (Practical)"
        YP3[Your Phone<br/>Light Peer]
        YPC3[Your PC<br/>Full Peer]
        FPC3[Friend's PC<br/>Full Peer]
        FP3[Friend's Phone<br/>Light Peer]
        
        YP3 -->|prefers| YPC3
        YPC3 <-->|always| FPC3
        FP3 -->|prefers| FPC3
        YP3 -.->|fallback<br/>if PC offline| FPC3
        YP3 -.->|fallback| FP3
        
        style YP3 fill:#f9ca24
        style YPC3 fill:#6ab04c
        style FPC3 fill:#6ab04c
        style FP3 fill:#f9ca24
    end
