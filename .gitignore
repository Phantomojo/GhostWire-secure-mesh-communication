# GhostWire Core Exclusions

# Rust Build Artifacts (Recursive)
target/
*.rs.bk
*.rs.bak
*.profraw
*.profdata
flamegraph.svg
coverage/
*.lcov

# Node.js / Frontend Artifacts (Recursive)
node_modules/
npm-debug.log*
yarn-debug.log*
webui/dist/
dist/
build/

# IDE & OS Junk
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Secrets (MANDATORY EXCLUSIONS)
ghostwire_token.txt
username.txt
*.token
*.key
*.pem
*.enc
.env
.env.*
token
GHOSTWIRE_RELEASE_SIGNING_KEY_HEX

# Local Config (Keep templates, ignore live)
ghostwire.toml
config.toml
litellm-config.yaml
ghostwire_settings.json

# Databases & Runtime Data
.ghostwire_db/
ghostwire/data/advisory-db/
*.log
build_errors.txt

# External SDKs & Large Blobs (Not Code)
esp-idf/
ghostwire-libs/
ghostwire/vendor/
release/
archives/
team_packages/

# Temporary / AI Scaffolding
.qwen/
*_AGENT_*.md
*_AGENT_*.zip
*_STATUS.md
*_SUMMARY.md
*_BRIEF.md
*_COMPLETE.md
*_PROGRESS.md
