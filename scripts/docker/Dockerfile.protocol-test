# Dockerfile for GhostWire Protocol Testing
# Builds a minimal image for running protocol-level integration tests

# =============================================================================
# Stage 1: Builder
# =============================================================================
FROM rust:1.75-bookworm AS builder

RUN mkdir -p /root/.cargo && printf '[build]\njobs = "n"\n\n[target.x86_64-unknown-linux-gnu]\nlinker = "cc"\n' > /root/.cargo/config.toml

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy Cargo files first (better layer caching)
COPY ghostwire/Cargo.toml ghostwire/Cargo.lock ./

# Create dummy main.rs to build dependencies
RUN mkdir -p src && echo "fn main() {}" > src/main.rs

# Build dependencies (cached layer)
RUN cargo build --release && rm -rf src

# Copy source code
COPY ghostwire/src ./src
COPY ghostwire/Cargo.toml ./
COPY ghostwire/build.rs ./
COPY ghostwire/tests ./tests

# Build tests
RUN cargo test --test protocol_integration --no-run

# =============================================================================
# Stage 2: Runtime (Minimal)
# =============================================================================
FROM debian:bookworm-slim

# Install ONLY runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create working directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/ghostwire /usr/local/bin/ghostwire

# Copy test binary
COPY --from=builder /app/target/debug/deps/protocol_integration* /usr/local/bin/protocol_integration

# Create test results directory
RUN mkdir -p /app/test-results && chmod 777 /app/test-results

# Set environment variables for testing
ENV RUST_LOG=ghostwire=debug,test=info
ENV RUST_BACKTRACE=1

# Default command: run protocol tests
ENTRYPOINT ["/usr/local/bin/protocol_integration"]
CMD []

# Health check (always passes if container is running)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD exit 0
