<!DOCTYPE html>
<html lang="en"><head>
<meta http-equiv="content-type" content="text/html; charset=UTF-8">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Michael Irungu Muriithi — CV</title>
<link href="Michael%20Irungu%20Muriithi%20%E2%80%94%20CV_files/css2.css" rel="stylesheet">
<style>
  :root {
    --abyss: #010205;
    --abyss-mid: #0a0d14;
    --abyss-light: #12151f;
    --gold: #DB9202;
    --gold-dim: #a06c02;
    --gold-faint: rgba(219,146,2,0.08);
    --text: #e8e4d9;
    --text-dim: #9a9688;
    --text-faint: #5a5750;
    --border: rgba(219,146,2,0.2);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--abyss);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    font-weight: 300;
    font-size: 13px;
    line-height: 1.6;
    max-width: 900px;
    margin: 0 auto;
    padding: 48px 40px;
  }

  .header {
    border-bottom: 1px solid var(--border);
    padding-bottom: 28px;
    margin-bottom: 32px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: end;
  }

  .name-block h1 {
    font-family: 'Cinzel', serif;
    font-size: 32px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.04em;
    line-height: 1.1;
    margin-bottom: 4px;
  }

  .name-block .alias {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    color: var(--gold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .name-block .title {
    font-size: 13px;
    font-weight: 400;
    color: var(--text-dim);
    letter-spacing: 0.02em;
  }

  .contact-block {
    text-align: right;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    color: var(--text-dim);
    line-height: 2;
  }

  .contact-block a { color: var(--gold); text-decoration: none; }

  .gold-rule {
    width: 40px;
    height: 2px;
    background: var(--gold);
    margin: 6px 0 12px 0;
  }

  .section { margin-bottom: 32px; }

  .section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .section-header h2 {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    font-weight: 600;
    color: var(--gold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .section-header::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .summary {
    font-size: 13px;
    color: var(--text-dim);
    line-height: 1.8;
    font-weight: 300;
    border-left: 2px solid var(--gold);
    padding-left: 16px;
  }

  .summary strong { color: var(--text); font-weight: 500; }

  .entry {
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(219,146,2,0.08);
  }

  .entry:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }

  .entry-header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    margin-bottom: 4px;
  }

  .entry-title {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.02em;
  }

  .entry-org {
    font-size: 11px;
    color: var(--gold);
    font-weight: 400;
    margin-bottom: 6px;
  }

  .entry-date {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .entry-desc { font-size: 12.5px; color: var(--text-dim); line-height: 1.7; }

  .entry-desc li {
    list-style: none;
    padding-left: 14px;
    position: relative;
    margin-bottom: 3px;
  }

  .entry-desc li::before {
    content: '◆';
    position: absolute;
    left: 0;
    color: var(--gold-dim);
    font-size: 7px;
    top: 5px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  .tag {
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    color: var(--gold-dim);
    background: var(--gold-faint);
    border: 1px solid rgba(219,146,2,0.15);
    padding: 2px 7px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .skill-group h3 {
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    color: var(--gold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .skill-group ul { list-style: none; }

  .skill-group ul li {
    font-size: 12px;
    color: var(--text-dim);
    padding: 2px 0;
    border-bottom: 1px solid rgba(219,146,2,0.05);
  }

  .skill-group ul li span {
    color: var(--text-faint);
    font-size: 10px;
    font-family: 'Space Mono', monospace;
    float: right;
  }

  .ctf-entry {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    margin-bottom: 14px;
    align-items: start;
  }

  .ctf-rank {
    font-family: 'Cinzel', serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--gold);
    line-height: 1;
    min-width: 48px;
    text-align: center;
  }

  .ctf-rank small {
    display: block;
    font-family: 'Space Mono', monospace;
    font-size: 8px;
    color: var(--text-faint);
    font-weight: 400;
    letter-spacing: 0.1em;
    margin-top: 2px;
  }

  .ctf-detail h4 {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 3px;
  }

  .ctf-detail p { font-size: 11.5px; color: var(--text-dim); line-height: 1.6; }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .edu-entry { margin-bottom: 12px; }

  .edu-entry h3 {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 2px;
  }

  .edu-entry p { font-size: 11.5px; color: var(--text-dim); }
  .edu-entry .status { font-size: 10px; color: var(--gold-dim); font-family: 'Space Mono', monospace; }

  .metrics-row {
    display: flex;
    gap: 24px;
    margin: 10px 0 6px 0;
    flex-wrap: wrap;
  }

  .metric {
    text-align: center;
  }

  .metric .num {
    font-family: 'Cinzel', serif;
    font-size: 16px;
    color: var(--gold);
    font-weight: 700;
    display: block;
  }

  .metric .label {
    font-family: 'Space Mono', monospace;
    font-size: 8px;
    color: var(--text-faint);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer {
    margin-top: 36px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer p {
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    color: var(--text-faint);
    letter-spacing: 0.1em;
  }

  .footer .mark { font-family: 'Cinzel', serif; font-size: 10px; color: var(--gold); letter-spacing: 0.2em; }

  @media print {
    body {
      background: #010205;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
      padding: 32px;
    }
    .section { page-break-inside: avoid; }
  }
</style>
<link type="text/css" rel="stylesheet" id="dark-mode-custom-link"><link type="text/css" rel="stylesheet" id="dark-mode-general-link"><style lang="en" type="text/css" id="dark-mode-custom-style"></style><style lang="en" type="text/css" id="dark-mode-native-style"></style><style lang="en" type="text/css" id="dark-mode-native-sheet"></style></head>
