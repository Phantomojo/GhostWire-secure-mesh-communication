# GhostWire Environment Configuration
# Copy this file to .env and fill in the values.
# cp .env.example .env

# ============================================================
# Matrix Bridge (optional — enable with features.matrix_bridge=true)
# ============================================================
GHOSTWIRE_MATRIX_HOMESERVER=https://matrix.org
GHOSTWIRE_MATRIX_USER=@ghostwire:matrix.org
GHOSTWIRE_MATRIX_ACCESS_TOKEN=
GHOSTWIRE_MATRIX_PASSWORD=

# ============================================================
# Kaggle (for GPU model training)
# ============================================================
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=

# ============================================================
# Ollama / Gemma 4 AI (optional)
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# ============================================================
# Server Configuration
# ============================================================
GHOSTWIRE_HOST=127.0.0.1
GHOSTWIRE_PORT=8080
GHOSTWIRE_WS_PORT=9090

# ============================================================
# Release Signing (for automatic updates)
# ============================================================
# GHOSTWIRE_RELEASE_SIGNING_KEY_HEX=

# ============================================================
# Meshtastic (optional — enable with features.meshtastic=true)
# ============================================================
# MESHTASTIC_DEVICE=/dev/ttyUSB0
# MESHTASTIC_CHANNEL=main

# ============================================================
# Sentry Error Tracking (optional — for production monitoring)
# ============================================================
# Get your DSN from: https://sentry.io/organizations/<org>/projects/<project>/keys/
# GHOSTWIRE_SENTRY_DSN=https://<key>@o<org_id>.ingest.sentry.io/<project_id>

# ============================================================
# Datadog APM (optional — distributed tracing, metrics, profiling)
# ============================================================
# Get your API key from: https://app.datadoghq.com/organization-settings/api-keys
# DD_API_KEY=<your-datadog-api-key>
# DD_SERVICE=ghostwire
# DD_ENV=development          # change to 'production' for prod
# DD_VERSION=0.2.0
# DD_TRACE_AGENT_URL=http://localhost:8126  # Datadog Agent endpoint
