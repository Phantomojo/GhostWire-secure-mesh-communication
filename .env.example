# GhostWire Environment Configuration
# Copy this file to .env and fill in the values.
# cp .env.example .env

# ============================================================
# Matrix Bridge (optional — enable with features.matrix_bridge=true)
# ============================================================
GHOSTWIRE_MATRIX_HOMESERVER=https://matrix.org
GHOSTWIRE_MATRIX_USER=@ghostwire:matrix.org
GHOSTWIRE_MATRIX_ACCESS_TOKEN=
GHOSTWIRE_MATRIX_PASSWORD=

# ============================================================
# Kaggle (for GPU model training)
# ============================================================
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=

# ============================================================
# Ollama / Gemma 4 AI (optional)
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# ============================================================
# Server Configuration
# ============================================================
GHOSTWIRE_HOST=127.0.0.1
GHOSTWIRE_PORT=8080
GHOSTWIRE_WS_PORT=9090

# ============================================================
# Release Signing (for automatic updates)
# ============================================================
# GHOSTWIRE_RELEASE_SIGNING_KEY_HEX=

# ============================================================
# Meshtastic (optional — enable with features.meshtastic=true)
# ============================================================
# MESHTASTIC_DEVICE=/dev/ttyUSB0
# MESHTASTIC_CHANNEL=main
