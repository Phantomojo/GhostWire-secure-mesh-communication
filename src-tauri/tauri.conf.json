{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ghostwire",
  "version": "0.1.0",
  "identifier": "org.ghostwire.messenger",
  "build": {
    "frontendDist": "../webui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ../webui",
    "beforeBuildCommand": "npm run build --prefix ../webui"
  },
  "app": {
    "windows": [
      {
        "title": "GhostWire Messenger",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/ghostwire"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}