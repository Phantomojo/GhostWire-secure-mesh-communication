# Maintainer: GhostWire Team <team@ghostwire.app>
pkgname=ghostwire
pkgver=0.1.0
pkgrel=1
pkgdesc="Secure mesh networking and messaging platform"
arch=('x86_64')
url="https://github.com/Phantomojo/GhostWire-secure-mesh-communication"
license=('AGPL-3.0-or-later')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'rust')
options=('strip')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Phantomojo/GhostWire-secure-mesh-communication/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/GhostWire-secure-mesh-communication-$pkgver/ghostwire"
    cargo build --release --locked
}

package() {
    cd "$srcdir/GhostWire-secure-mesh-communication-$pkgver"
    
    # Install binary
    install -Dm755 "ghostwire/target/release/ghostwire" "$pkgdir/usr/bin/ghostwire"
    
    # Install config example
    install -Dm644 "ghostwire.conf" "$pkgdir/etc/ghostwire/ghostwire.conf.example"
    
    # Install systemd service
    install -Dm644 "systemd/ghostwire.service" "$pkgdir/usr/lib/systemd/system/ghostwire.service"
}
