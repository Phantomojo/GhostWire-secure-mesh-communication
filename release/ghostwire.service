[Unit]
Description=GhostWire Secure Mesh Networking Service
Documentation=https://github.com/Phantomojo/GhostWire-secure-mesh-communication
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ghostwire
ExecStart=/usr/local/bin/ghostwire --config /etc/ghostwire/ghostwire.toml web
Restart=on-failure
RestartSec=10
TimeoutStartSec=30

# Security settings
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ghostwire

[Install]
WantedBy=multi-user.target
