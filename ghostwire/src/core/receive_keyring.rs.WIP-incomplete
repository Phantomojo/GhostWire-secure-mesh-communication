// ── Constants ─────────────────────────────────────────────────────────────────────

/// SPK rotation interval: 1 hour, checked on the existing 1h tick
pub const RECEIVE_KEY_ROTATION_MS: u64 = 3_600_000;

/// Maximum age for a prekey to remain in the ring before GC evacuation
pub const RETENTION: u64 = 6 * 3_600_000;

/// Minimum unissued OTKs to maintain in the pool
pub const REPLENISH_FLOOR: usize = 8;

/// Maximum total OTKs allowed in the pool
pub const REPLENISH_CEILING: usize = 24;

/// Maximum secrets iterated during trial decryption (newest OTKs first, then SPKs)
pub const OPEN_SECRET_CAP: usize = 28;

// ── Types ─────────────────────────────────────────────────────────────────────────

/// A prekey entry in the receive key ring — either an SPK or an OTK.
#[derive(Debug, Clone)]
pub struct PrekeyEntry {
    /// Key ID (base58-encoded X25519 public key for SPK, or OTK identifier)
    pub key_id: String,
    /// Key type
    pub key_type: KeyType,
    /// Created at (unix epoch seconds)
    pub created_at: u64,
    /// Issued to peer ID (tracked to prevent OTK reuse across peers)
    pub issued_to: Option<String>,
    /// Timestamp when this key was last used (for OTK consumption tracking)
    pub last_used_at: Option<u64>,
    /// TTL for the key in the ring (seconds)
    pub ttl: u64,
}

/// The receive key ring — SPKs per peer + a pool of OTKs shared globally (or per-peer).
#[derive(Debug, Clone)]
pub struct ReceiveKeyRing {
    /// Per-peer static prekey (X25519), one per connected peer.
    pub spk_map: DashMap<String, PrekeyEntry>,
    /// Global OTK pool — shared across peers or per-peer depending on deployment.
    pub otk_pool: DashMap<String, OtkEntry>,
    /// CRL store for revocation gating
    pub crl: Arc<CrlStore>,
    /// Node master seed for deriving the at-rest storage key
    pub master_seed: Vec<u8>,
    /// Last GC timestamp (for retention sweep)
    pub last_gc: AtomicU64,
    /// Last rotation timestamp (for SPK rotation on 1h tick)
    pub last_rotation: AtomicU64,
}

impl ReceiveKeyRing {
    /// Create a new receive key ring with the given master seed for at-rest encryption.
    pub fn new(master_seed: Vec<u8>, crl: Arc<CrlStore>) -> Self {
        Self {
            spk_map: DashMap::new(),
            otk_pool: DashMap::new(),
            crl,
            master_seed,
            last_gc: AtomicU64::new(0),
            last_rotation: AtomicU64::new(0),
        }
    }

    /// SPK rotation: rotate only when age ≥ 1h (checked on 1h tick, not every call)
    pub fn maybe_rotate_spk(&self, peer_id: &str) {
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();

        let last = self.last_rotation.load(Ordering::Acquire);
        if now.saturating_sub(last) >= 3_600_000 {
            // Rotate: remove old SPK for this peer, keep any fresh ones
            self.spk_map.retain(|_, entry| {
                entry.last_used_at.map_or(true, |last| {
                    now.saturating_sub(last) < 3_600_000
                })
            });
            self.last_rotation.store(now, Ordering::Release);
            info!(peer_id = %peer_id, "Rotated SPK on 1h tick");
        }
    }

    /// Fill the OTK pool to at least `floor` unissued keys, up to `ceiling` total.
    pub fn fill_otk_pool(&self, floor: usize, ceiling: usize) {
        let current = self.otk_pool.len();
        if current >= ceiling {
            debug!(current = current, "OTK pool already at ceiling, skipping replenish");
            return;
        }
        let needed = floor.saturating_sub(current);
        if needed > 0 {
            info!(needed = needed, "Filling OTK pool to {} unissued keys", floor);
            // Issue new OTKs (placeholder — actual ECDH would happen at sender)
            for _ in 0..needed {
                let otk_id = format!("otk_{}", std::time::SystemTime::now()
                    .duration_since(std::time::UNIX_EPOCH)
                    .unwrap()
                    .as_secs());
                let entry = PrekeyEntry {
                    key_id: otk_id.clone(),
                    key_type: KeyType::X25519,
                    created_at: std::time::SystemTime::now()
                        .duration_since(std::time::UNIX_EPOCH)
                        .unwrap()
                        .as_secs(),
                    issued_to: None,
                    last_used_at: None,
                    ttl: 3_600_000, // 1 hour TTL per OTK
                };
                self.otk_pool.insert(otk_id.clone(), entry);
            }
        }
    }

    /// Consume an OTK on successful open (per-message forward secrecy).
    /// Returns `true` if the OTK was found and consumed.
    pub fn consume_otk(&self, otk_id: &str, sender: &str) -> bool {
        if let Some(mut entry) = self.otk_pool.remove(otk_id) {
            entry.last_used_at = Some(
                std::time::SystemTime::now()
                    .duration_since(std::time::UNIX_EPOCH)
                    .unwrap()
                    .as_secs(),
            );
            // Re-insert with updated last_used_at
            self.otk_pool.insert(otk_id.to_string(), entry);
            true
        } else {
            debug!(otk_id = %otk_id, "OTK not found in pool (already consumed or never issued)");
            false
        }
    }

    /// Unknown-key messages that fail trial are requeued into a bounded pending queue.
    /// Key is `(sender, content_hash)` with a 6h TTL.
    /// Returns the queue key for potential retry.
    pub fn requeue_unknown_key(
        &self,
        sender: &str,
        content_hash: &str,
    ) -> Option<String> {
        let queue_key = format!("{}:{}", sender, content_hash);
        // Placeholder: in a full impl, this would insert into a bounded TTL queue
        // For now, just return the queue key for the caller to manage
        Some(queue_key)
    }

    /// Trial decryption: iterate secrets (newest OTKs first, then SPKs, cap 28).
    /// On OTK hit, consume it. On SPK hit, establish session then hand off to
    /// double-ratchet for subsequent messages.
    /// Returns `true` if decryption succeeded (key consumed or session established).
    pub fn trial_decrypt(
        &self,
        sender: &str,
        ciphertext: &[u8],
        epoch: u64,
    ) -> anyhow::Result<bool> {
        // CRL gate: first check before ANY trial
        if self.crl.is_revoked(sender) {
            return Err(anyhow!("Sender key {} is revoked", sender).into());
        }

        // Epoch freshness check: reject stale epochs (below high-water)
        if let Some(high) = self.crl.peer_epochs.get(sender) {
            if epoch < *high {
                warn!(
                    sender = %sender,
                    epoch,
                    high_water = *high,
                    "Stale epoch rejected"
                );
                return Err(anyhow!("Stale epoch rejected; expected >= {}", high).into());
            }
        }

        // Try OTKs newest first, cap at OPEN_SECRET_CAP
        let mut otk_tried = 0usize;
        let otk_entries: Vec<(String, crate::core::encryption::GhostKeyPair)> = self
            .otk_pool
            .iter()
            .map(|(k, v)| (k.clone(), v.clone()))
            .collect();
        // Sort by creation time descending (newest first)
        let mut otk_sorted = otk_entries;
        otk_sorted.sort_by(|a, b| b.1.created_at.cmp(&a.1.created_at));

        for (otk_id, otk_entry) in &otk_sorted {
            if otk_tried >= OPEN_SECRET_CAP {
                break;
            }
            // Skip OTKs issued to a different peer (forward secrecy)
            if let Some(ref issued_to) = otk_entry.issued_to {
                if issued_to != sender {
                    // OTK issued to another peer; still count as tried but don't consume
                    // unless it matches this sender (per-peer tracking)
                    otk_tried += 1;
                    continue;
                }
            }

            // Check if OTK is still valid (not expired by TTL)
            let otk_age = std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs()
                .saturating_sub(otk_entry.created_at);
            if otk_age > otk_entry.ttl {
                // Expired OTK — remove from pool
                let _ = self.otk_pool.remove(otk_id);
                continue;
            }

            // Consume the OTK on successful open
            if self.consume_otk(otk_id, sender) {
                info!(
                    sender = %sender,
                    otk_id = %otk_id,
                    "OTK consumed on trial decryption"
                );
                return Ok(true);
            }
            otk_tried += 1;
        }

        // Try SPKs (static prekeys), cap at OPEN_SECRET_CAP - otk_tried
        let remaining_cap = OPEN_SECRET_CAP.saturating_sub(otk_tried);
        let mut spk_tried = 0usize;
        let spk_entries: Vec<(String, crate::core::encryption::GhostKeyPair)> = self
            .spk_map
            .iter()
            .map(|(k, v)| (k.clone(), v.clone()))
            .collect();
        // Sort by creation time descending (newest first)
        let mut spk_sorted = spk_entries;
        spk_sorted.sort_by(|a, b| b.1.created_at.cmp(&a.1.created_at));

        for (spk_id, spk_entry) in &spk_sorted {
            if spk_tried >= remaining_cap {
                break;
            }

            // Check if SPK is still valid (not expired)
            let spk_age = std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs()
                .saturating_sub(spk_entry.created_at);
            if spk_age > RETENTION {
                // Expired SPK — remove from ring
                let _ = self.spk_map.remove(spk_id);
                continue;
            }

            // Establish session via SPK → hand off to double-ratchet
            info!(
                sender = %sender,
                spk_id = %spk_id,
                "Establishing session via SPK, handing off to double-ratchet"
            );
            // TODO: Actually establish the double-ratchet session here
            // For now, mark the SPK as used and hand off
            spk_tried += 1;
        }

        // No key matched within cap
        warn!(
            sender = %sender,
            "Trial decryption failed: no matching OTK/SPK within cap of {}",
            OPEN_SECRET_CAP
        );
        Ok(false)
    }

    /// GC/rotation sweep: call periodically (e.g. on the 1h tick alongside CRL GC).
    pub fn gc_sweep(&self) {
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();

        // GC: evacuate expired SPKs (older than RETENTION)
        let gc_count = self
            .spk_map
            .retain(|_, entry| {
                let age = now.saturating_sub(entry.created_at);
                age < RETENTION
            });
        if gc_count > 0 {
            debug!(removed = gc_count, "GC swept expired SPKs from receive key ring");
        }

        // Rotation: check if 1h tick has elapsed since last rotation
        let last = self.last_rotation.load(Ordering::Acquire);
        if now.saturating_sub(last) >= 3_600_000 {
            self.maybe_rotate_spk("");
        }
    }

} // end of `impl ReceiveKeyRing`

/// Zeroize-on-drop: all key material zeroized on drop.
impl Drop for ReceiveKeyRing {
        fn drop(&mut self) {
            // Zeroize SPK entries
            for (_k, v) in self.spk_map.iter() {
                v.key_id.zeroize();
            }
            // Zeroize OTK entries
            for (_k, v) in self.otk_pool.iter() {
                v.key_id.zeroize();
            }
            // Clear maps
            self.spk_map.clear();
            self.otk_pool.clear();
        }
    }